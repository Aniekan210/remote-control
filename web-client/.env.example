# Next.js web app (control.aniekan.dev). Copy to .env.local or set in your host.

# ── Already needed ───────────────────────────────────────────────────
DATABASE_URL=postgres://...
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=https://control.aniekan.dev
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
CONTROL_WS_URL=https://api.control.aniekan.dev

# ── New ──────────────────────────────────────────────────────────────
CONTROL_SHARED_SECRET=   # SAME value as the Go server — signs the 60s connect tokens
KEY_ENCRYPTION_SECRET=   # SAME value as the Go server — encrypts saved OpenRouter keys

# Go control server (api.control.aniekan.dev). Copy to .env or set in your host.
# Generate secrets with: openssl rand -hex 32

# ── Required ─────────────────────────────────────────────────────────
OPENROUTER_API_KEY=sk-or-...          # the server's own key (owners only)
CONTROL_SHARED_SECRET=                # SAME value as the web app; unset = /ws auth OFF
DATABASE_URL=postgres://...           # SAME Neon database as the web app
KEY_ENCRYPTION_SECRET=                # SAME value as the web app; decrypts users' keys
OWNER_USER_IDS=                       # comma-separated web-app user ids allowed on the server key
COST_STATE_FILE=/data/cost-state.json # must be on persistent disk, or the monthly total resets on redeploy

# ── Optional (defaults shown) ────────────────────────────────────────
# MONTHLY_BUDGET_USD=6
# MAX_AI_CALLS_PER_TASK=150
# MAX_PLANNER_CALLS_PER_TASK=12
# MAX_TASK_COST_USD=0.50
# MAX_TASK_DURATION=30m
# MAX_AUTO_REPLANS=3               # per problem: refills after 2 steps of progress
# PLANNING_MODEL=google/gemini-3.1-pro-preview
# EXECUTION_MODEL=qwen/qwen2.5-vl-72b-instruct
# EXECUTION_COORDS=pixels            # or norm1000, if the executor model's card says so
# PLANNER_MAX_TOKENS=2000
# PLANNER_REASONING_EFFORT=low       # first plan; "none" to leave reasoning off the request
# REVISE_REASONING_EFFORT=medium     # revising a plan that went wrong
# EXECUTOR_TEMPERATURE=0
